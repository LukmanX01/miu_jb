local function MakeToggle(label, icon, key, onOn, onOff)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,-12,0,44)
    Btn.BackgroundColor3 = Color3.fromRGB(28,28,42)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.Text = icon.."  "..label.."  [ OFF ]"
    Btn.TextColor3 = Color3.fromRGB(200,200,200)
    Btn.TextSize = 13
    Btn.Parent = Scroll
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,8)

    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        State[key] = active
        if active then
            Btn.BackgroundColor3 = Color3.fromRGB(255,100,0)
            Btn.TextColor3 = Color3.fromRGB(255,255,255)
            Btn.Text = icon.."  "..label.."  [ ON ]"
            if onOn then task.spawn(onOn) end
        else
            Btn.BackgroundColor3 = Color3.fromRGB(28,28,42)
            Btn.TextColor3 = Color3.fromRGB(200,200,200)
            Btn.Text = icon.."  "..label.."  [ OFF ]"
            if onOff then onOff() end
        end
    end)
end

