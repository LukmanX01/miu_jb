-- xyro | Jailbreak Script
-- Called from Loader.lua

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

local State = {
    AutoRob = false,
    AutoFarm = false,
    ESP = false,
    SpeedHack = false,
    Fly = false,
    AutoArrest = false,
    AntiRagdoll = false,
    MenuOpen = false,
}

local FlySpeed = 60
local SpeedValue = 80
local FlyBV, FlyBG = nil, nil

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "xyroESP"
ESPFolder.Parent = game.CoreGui

-- ========================
-- UTILS
-- ========================

local function Notify(msg)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "⚡ xyro Loader";
        Text = msg;
        Duration = 3;
    })
end

local function RefreshChar()
    Character = LocalPlayer.Character
    if Character then
        Humanoid = Character:FindFirstChildOfClass("Humanoid")
        RootPart = Character:FindFirstChild("HumanoidRootPart")
    end
end

LocalPlayer.CharacterAdded:Connect(function(c)
    Character = c
    Humanoid = c:WaitForChild("Humanoid")
    RootPart = c:WaitForChild("HumanoidRootPart")
end)

-- ========================
-- ANTI RAGDOLL
-- ========================

local function AntiRagdoll()
    if not Character then return end
    for _, v in pairs(Character:GetDescendants()) do
        if v:IsA("BallSocketConstraint") or v:IsA("HingeConstraint") then
            v.Enabled = false
        end
    end
end

-- ========================
-- SPEED
-- ========================

local function SetSpeed(on)
    RefreshChar()
    if Humanoid then
        Humanoid.WalkSpeed = on and SpeedValue or 16
    end
end

-- ========================
-- FLY
-- ========================

local function StartFly()
    RefreshChar()
    if not RootPart then return end

    FlyBV = Instance.new("BodyVelocity")
    FlyBV.MaxForce = Vector3.new(1e5,1e5,1e5)
    FlyBV.Velocity = Vector3.zero
    FlyBV.Parent = RootPart

    FlyBG = Instance.new("BodyGyro")
    FlyBG.MaxTorque = Vector3.new(1e5,1e5,1e5)
    FlyBG.D = 100
    FlyBG.Parent = RootPart

    RunService.Heartbeat:Connect(function()
        if not State.Fly then
            if FlyBV then FlyBV:Destroy() FlyBV = nil end
            if FlyBG then FlyBG:Destroy() FlyBG = nil end
            return
        end
        local cam = workspace.CurrentCamera
        if FlyBV then FlyBV.Velocity = cam.CFrame.LookVector * FlySpeed end
        if FlyBG then FlyBG.CFrame = cam.CFrame end
    end)
end

local function StopFly()
    State.Fly = false
    if FlyBV then FlyBV:Destroy() FlyBV = nil end
    if FlyBG then FlyBG:Destroy() FlyBG = nil end
    RefreshChar()
    if Humanoid then Humanoid.PlatformStand = false end
end

-- ========================
-- ESP
-- ========================

local function ClearESP() for _, v in pairs(ESPFolder:GetChildren()) do v:Destroy() end end

local function CreateESP()
    ClearESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local bb = Instance.new("BillboardGui")
            bb.AlwaysOnTop = true
            bb.Size = UDim2.new(0,100,0,40)
            bb.Name = p.Name.."_esp"

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.fromScale(1,1)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = Color3.fromRGB(255,70,70)
            lbl.TextStrokeTransparency = 0
            lbl.TextScaled = true
            lbl.Font = Enum.Font.GothamBold
            lbl.Text = p.Name
            lbl.Parent = bb

            local function Attach()
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    bb.Adornee = p.Character.HumanoidRootPart
                    bb.Parent = ESPFolder
                end
            end
            Attach()
            p.CharacterAdded:Connect(Attach)
        end
    end
end

Players.PlayerAdded:Connect(function() if State.ESP then CreateESP() end end)
Players.PlayerRemoving:Connect(function(p)
    local t = ESPFolder:FindFirstChild(p.Name.."_esp")
    if t then t:Destroy() end
end)

-- ========================
-- AUTO ROB
-- ========================

local RobTargets = {"Bank","JewelryStore","DonutShop","MuseumInterior","CargoShip"}

local function AutoRobLoop()
    while State.AutoRob do
        for _, name in pairs(RobTargets) do
            if not State.AutoRob then break end
            local t = workspace:FindFirstChild(name, true)
            if t then
                local part = t:FindFirstChildWhichIsA("BasePart")
                if part and RootPart then
                    local tw = TweenService:Create(RootPart, TweenInfo.new(2), {
                        CFrame = part.CFrame + Vector3.new(0,3,0)
                    })
                    tw:Play()
                    tw.Completed:Wait()
                end
            end
            task.wait(5)
        end
        task.wait(1)
    end
end

-- ========================
-- AUTO FARM
-- ========================

local function AutoFarmLoop()
    while State.AutoFarm do
        for _, obj in pairs(workspace:GetDescendants()) do
            if not State.AutoFarm then break end
            if obj:IsA("BasePart") and (
                obj.Name:lower():find("cash") or
                obj.Name:lower():find("money") or
                obj.Name:lower():find("atm") or
                obj.Name:lower():find("register")
            ) then
                if RootPart then
                    RootPart.CFrame = obj.CFrame + Vector3.new(0,3,0)
                    task.wait(0.5)
                end
            end
        end
        task.wait(2)
    end
end

-- ========================
-- AUTO ARREST
-- ========================

local function AutoArrestLoop()
    while State.AutoArrest do
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local c = p.Character
                if c then
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if r and RootPart then
                        if (RootPart.Position - r.Position).Magnitude < 15 then
                            RootPart.CFrame = r.CFrame + Vector3.new(0,0,-2)
                            task.wait(0.3)
                        end
                    end
                end
            end
        end
        task.wait(1)
    end
end

